digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.42", fontname="DejaVu Sans"];
 node [shape=box, style="rounded,filled", color="#7D8CA0", fillcolor="#F7FAFD", fontname="DejaVu Sans", fontsize=12, margin="0.22,0.13"];
 edge [color="#66778A", penwidth=1.6, arrowsize=.85];
 input [label="Scheduler / input buffer\nOne-Hot: data-selection logic\nFanout: address-register source", fillcolor="#DFF4EE"];
 hidden [label="Hidden layer\n4 MAC lanes + biases", fillcolor="#EAFAEF"];
 relu [label="8 ReLU outputs", fillcolor="#EAFAEF"];
 output [label="Output layer\nPipeline registers between select, multiply and accumulation", fillcolor="#DBEBFF"];
 y [label="Q8.8 output", fillcolor="#F0F3F8"];
 input -> hidden -> relu -> output -> y;
}
