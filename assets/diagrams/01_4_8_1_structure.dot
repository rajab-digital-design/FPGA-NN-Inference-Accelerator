digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.42", fontname="DejaVu Sans"];
 node [shape=box, style="rounded,filled", color="#7D8CA0", fillcolor="#F7FAFD", fontname="DejaVu Sans", fontsize=13, margin="0.22,0.13"];
 edge [color="#66778A", penwidth=1.6, arrowsize=.85];
 x [label="4 inputs\nx1 ... x4", fillcolor="#EDF4FF"];
 w1 [label="W1 weights + b1 biases\n32 weights, 8 biases", fillcolor="#FFF4E5"];
 h [label="Four parallel MAC lanes\n8 hidden neurons in two groups", fillcolor="#EAF8EF"];
 relu [label="ReLU activation\nRegister 8 hidden outputs", fillcolor="#EAF8EF"];
 w2 [label="W2 weights + b2 bias\n8 weights, 1 bias", fillcolor="#FFF4E5"];
 o [label="One output-layer MAC\nQ8.8 final output", fillcolor="#EAF1FF"];
 x -> w1 -> h -> relu -> w2 -> o;
}
